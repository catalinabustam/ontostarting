:AiryTexture a owl:Class ;
    rdfs:label "airy texture"@en ;
    rdfs:comment "Delicate crumb structure."@en ;
    rdfs:subClassOf :DoughTexture .

:AnchovyIngredient a owl:Class ;
    rdfs:label "anchovy ingredient"@en ;
    rdfs:comment "An ingredient derived from anchovies, often used to add a salty and umami flavor to dishes."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom :HighSalt ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :SodiumMeasurement [ a owl:Restriction ;
                                owl:onProperty sulo:hasPart ;
                                owl:someValuesFrom :Milligram ] [ a owl:Restriction ;
                                owl:onProperty sulo:hasValue ;
                                owl:someValuesFrom [ a rdfs:Datatype ;
                                        owl:onDatatype xsd:integer ;
                                        owl:withRestrictions ( [ xsd:minInclusive 1400 ] ) ] ] ) ] ],
        :FoodMaterial .

:BakerRole a owl:Class ;
    rdfs:label "baker role"@en ;
    rdfs:comment "The BakerRole is the crust of the pizza."@en ;
    rdfs:subClassOf <https://w3id.org/ontostart/pro/AgentRole> .

:BakingEndTime a owl:Class ;
    rdfs:label "baking end time"@en ;
    rdfs:comment "The time when the baking process ends"@en ;
    rdfs:subClassOf sulo:EndTime .

:BakingStartTime a owl:Class ;
    rdfs:label "baking start time"@en ;
    rdfs:comment "The BakingStartTime refers to the moment when the pizza is placed in the oven, signaling the beginning of a crucial 10-15 minute window where the crust is transformed from soft and pliable to golden brown and crispy."@en ;
    rdfs:subClassOf sulo:StartTime .

:DeliveryDuration a owl:Class ;
    rdfs:label "delivery duration"@en ;
    rdfs:comment "\"Time from dough to doorstep\"."@en ;
    rdfs:subClassOf sulo:Duration .

:DesaltedAnchovyIngredient a owl:Class ;
    rdfs:label "desalted anchovy ingredient"@en ;
    rdfs:comment "An anchovy ingredient that has undergone a desalting process to reduce its salt content."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :SodiumMeasurement [ a owl:Restriction ;
                                owl:onProperty sulo:hasPart ;
                                owl:someValuesFrom :Milligram ] [ a owl:Restriction ;
                                owl:allValuesFrom [ a rdfs:Datatype ;
                                        owl:onDatatype xsd:integer ;
                                        owl:withRestrictions ( [ xsd:maxInclusive 400 ] ) ] ;
                                owl:onProperty sulo:hasValue ] ) ] ],
        :FoodMaterial .

:DoughTexture a owl:Class ;
    rdfs:label "dough texture"@en ;
    rdfs:comment "Soft and airy."@en ;
    rdfs:subClassOf sulo:Quality .

:HotPepper a owl:Class ;
    rdfs:label "hot pepper"@en ;
    rdfs:comment """The word "HotPepper" evokes the spicy kick that adds a thrilling dimension to the art of pizza-making. As a pizza chef expertly sprinkles the fine powder of hot peppers onto the dough, the aroma of fiery heat wafts through the air, teasing the senses and building anticipation. The peppers, with their vibrant red hue, add a pop of color to the pie, as if to say, "This pizza is about to ignite your taste buds!"

As the pizza is placed in the fiery oven, the hot peppers begin to surrender their potency, releasing a slow-building cascade of heat that simmers beneath the surface. The cheese, now melted and golden, becomes a gentle conduit for the pepper's fiery essence, harmonizing the spicy and savory notes in a delicious pas de deux.

When the pizza emerges from the oven, the first bite transports the senses to a realm of sensory delight, as the hot pepper's sizzling essence dances on the palate, leaving a trail of warmth and wonder in its wake. It's a masterful blend of flavors and textures that redefines the pizza-making experience, leaving all who taste it begging for more of that tantalizing, tongue-tingling hot pepper magic."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :SpicinessMeasurement [ a owl:Restriction ;
                                owl:onProperty sulo:hasPart ;
                                owl:someValuesFrom :ScovilleHeatUnit ] [ a owl:Restriction ;
                                owl:onProperty sulo:hasValue ;
                                owl:someValuesFrom [ a rdfs:Datatype ;
                                        owl:onDatatype xsd:integer ;
                                        owl:withRestrictions ( [ xsd:minInclusive 500000 ] ) ] ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :SpicinessMeasurement [ a owl:Restriction ;
                                owl:onProperty sulo:hasPart ;
                                owl:someValuesFrom :ScovilleHeatUnit ] [ a owl:Restriction ;
                                owl:onProperty sulo:hasValue ;
                                owl:someValuesFrom [ a rdfs:Datatype ;
                                        owl:onDatatype xsd:integer ;
                                        owl:withRestrictions ( [ xsd:minInclusive 500000 ] ) ] ] ) ] ],
        :FoodMaterial ;
    owl:disjointWith :SpicySalami .

:MakingEndTime a owl:Class ;
    rdfs:label "making end time"@en ;
    rdfs:comment "The time when the pizza making process ends"@en ;
    rdfs:subClassOf sulo:EndTime .

:MakingStartTime a owl:Class ;
    rdfs:label "making start time"@en ;
    rdfs:comment "\"A culinary turning point\""@en ;
    rdfs:subClassOf sulo:StartTime .

:Milligram a owl:Class ;
    rdfs:label "milligram"@en ;
    rdfs:comment "A unit of mass equal to one thousandth of a gram."^^xsd:string ;
    rdfs:subClassOf sulo:Unit .

:Person a owl:Class ;
    rdfs:label "person"@en ;
    rdfs:comment "The person is the \"Pizza Taker\"."@en ;
    rdfs:subClassOf sulo:SpatialObject .

:PizzaMakingProcess a owl:Class ;
    rdfs:label "pizza making process"@en ;
    rdfs:comment "The art of crafting a perfect pie."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom :SlicingThePizza ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :AssemblingThePizza [ a owl:Restriction ;
                                owl:onProperty sulo:precedes ;
                                owl:someValuesFrom :BakingThePizza ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :ProofingTheDough [ a owl:Restriction ;
                                owl:onProperty sulo:precedes ;
                                owl:someValuesFrom :AssemblingThePizza ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :BakingThePizza [ a owl:Restriction ;
                                owl:onProperty sulo:precedes ;
                                owl:someValuesFrom :SlicingThePizza ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :MakingThePizzaDough [ a owl:Restriction ;
                                owl:onProperty sulo:precedes ;
                                owl:someValuesFrom :ProofingTheDough ] ) ] ],
        sulo:Process .

:PizzaSlice a owl:Class ;
    rdfs:label "pizza slice"@en ;
    rdfs:comment "A perfect, curved segment of savory, cheesy goodness."@en ;
    rdfs:subClassOf :FoodMaterial .

:ProofedDoughRole a owl:Class ;
    rdfs:label "proofed dough role"@en ;
    rdfs:comment "The role of proofing the pizza dough"@en ;
    rdfs:subClassOf sulo:Role .

:ProofingThePizzaDough_EndPhase a owl:Class ;
    rdfs:label "proofed dough role"@en ;
    rdfs:comment "The final stage of perfecting the pizza dough."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :ProofedDoughRole [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :PizzaDough ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :AiryTexture [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :PizzaDough ] ) ] ] ) ],
        sulo:Process .

:ProofingThePizzaDough_StartPhase a owl:Class ;
    rdfs:label "proofed dough role"@en ;
    rdfs:comment "The final proofing stage of the pizza dough, where the dough has doubled in size and has taken on a light, airy texture, ready to be shaped and topped."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :UnproofedDoughRole [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :PizzaDough ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :DenseTexture [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :PizzaDough ] ) ] ] ) ],
        sulo:Process .

:ScovilleHeatUnit a owl:Class ;
    rdfs:label "Scoville heat unit"@en ;
    rdfs:comment """A unit to measure the spiciness or "heat" of chili peppers and substances based on their concentration of capsaicinoids. 
                    The scale indicates how many times a chili extract must be diluted in sugar water before its heat is undetectable to tasters."""^^xsd:string ;
    rdfs:subClassOf sulo:Unit .

:SpicyMild a owl:Class ;
    rdfs:label "spicy mild"@en ;
    rdfs:comment "A low level of spiciness with minimal heat sensation."^^xsd:string ;
    rdfs:subClassOf :Spiciness .

:SpicyPizza a owl:Class ;
    rdfs:label "spicy pizza"@en ;
    rdfs:comment """Here's a short descriptive of the word "SpicyPizza" related to the process of a pizza:

"SpicyPizza" is a moment of culinary bliss when the aromatic essence of a freshly baked crust, the savory tang of melted mozzarella, and the bold zing of spicy sauce come together in perfect harmony. As the chef sprinkles a generous helping of fiery pepperoni slices and red pepper flakes across the surface, the room is filled with an irresistible aroma that teases the taste buds and builds anticipation. With the first slice lifted to the lips, the explosion of flavors - spicy, sweet, and savory - hits like a wave, leaving a trail of satisfied sighs and the promise of a perfectly cooked pie, carefully crafted to ignite the senses and leave a lasting impression."""@en ;
    rdfs:subClassOf :Pizza ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onProperty sulo:hasPart ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty sulo:hasFeature ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( :SpicinessMeasurement [ a owl:Restriction ;
                                                    owl:onProperty sulo:hasValue ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:integer ;
                                                            owl:withRestrictions ( [ xsd:minInclusive 300000 ] ) ] ] ) ] ] ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty sulo:hasFeature ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:unionOf ( :SpicyHot :SpicyMedium ) ] ] ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onProperty sulo:hasPart ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty sulo:hasFeature ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( :SpicinessMeasurement [ a owl:Restriction ;
                                                    owl:onProperty sulo:hasValue ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:integer ;
                                                            owl:withRestrictions ( [ xsd:minInclusive 300000 ] ) ] ] ) ] ] ] ) ] .

:TraditionalFourCheesePizza a owl:Class ;
    rdfs:label "traditional four cheese pizza"@en ;
    rdfs:comment "A Traditional Four Cheese Pizza is a pizza made with mozzarella, gorgonzola, parmesan, and pecorino romano."^^xsd:string ;
    rdfs:subClassOf :Pizza ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onClass :Mozzarella ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass :Gorgonzola ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass :Parmesan ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass :PecorinoRomano ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( :Mozzarella :Gorgonzola :Parmesan :PecorinoRomano ) ] ;
                        owl:onProperty sulo:hasDirectPart ] ) ] .

:box_containment_role_001 a owl:NamedIndividual,
        <https://w3id.org/ontostart/pro/ContainmentRole> ;
    sulo:isFeatureOf :delivery_box_001 .

:crust_of_my_pizza a owl:NamedIndividual,
        :PizzaCrust .

:pizza_contained_role_001 a owl:NamedIndividual,
        <https://w3id.org/ontostart/pro/ContainedRole> ;
    sulo:isFeatureOf :pizza_001 .

:AssemblingThePizza a owl:Class ;
    rdfs:label "assembling the pizza"@en ;
    rdfs:comment "Crafting"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/PersistingRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :Cheese ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/EmergingRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :Pizza ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :BakerRole [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :Person ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/PersistingRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :PizzaDough ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:precedes ;
            owl:someValuesFrom :BakingThePizza ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/PersistingRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom owl:Thing ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/PersistingRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :PizzaSauce ] ) ] ],
        <https://w3id.org/ontostart/pro/TransformationProcess> .

:HighSalt a owl:Class ;
    rdfs:label "high salt"@en ;
    rdfs:comment "A high level of saltiness."^^xsd:string ;
    rdfs:subClassOf :Saltiness .

:MakingThePizzaDough a owl:Class ;
    rdfs:label "making the pizza dough"@en ;
    rdfs:comment "\"Crafting\""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:precedes ;
            owl:someValuesFrom :ProofingTheDough ],
        [ a owl:Restriction ;
            owl:onProperty sulo:atTime ;
            owl:someValuesFrom :MakingStartTime ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <https://w3id.org/ontostart/pro/ConsumedRole> [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :Flour ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <https://w3id.org/ontostart/pro/ConsumedRole> [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :Water ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <https://w3id.org/ontostart/pro/ConsumedRole> [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :Sugar ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <https://w3id.org/ontostart/pro/ConsumedRole> [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :BakersYeast ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <https://w3id.org/ontostart/pro/ConsumedRole> [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :Salt ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <https://w3id.org/ontostart/pro/EmergingRole> [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :PizzaDough ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :BakerRole [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :Person ] ) ] ] ) ],
        [ a owl:Restriction ;
            owl:onProperty sulo:atTime ;
            owl:someValuesFrom :MakingEndTime ],
        <https://w3id.org/ontostart/pro/TransformationProcess> .

:Order a owl:Class ;
    rdfs:label "order"@en ;
    rdfs:comment "\"Structural harmony\"."@en ;
    rdfs:subClassOf sulo:InformationObject .

:PizzaCrust a owl:Class ;
    rdfs:label "pizza crust"@en ;
    rdfs:comment """A pizza crust is a food material resulting from the cooking of a dough 
                    and forms the base of a pizza upon which sauce and toppings are added."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasDirectPart ;
            owl:someValuesFrom :Cornicione ],
        :FoodMaterial .

:ProofingTheDough a owl:Class ;
    rdfs:label "proofing the dough"@en ;
    rdfs:comment "\"Science of making perfect crust\""@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty sulo:hasPart ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :ProofingThePizzaDough_StartPhase [ a owl:Restriction ;
                                            owl:onProperty sulo:precedes ;
                                            owl:someValuesFrom :ProofingThePizzaDough_EndPhase ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty sulo:hasPart ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :ProofingThePizzaDough_EndPhase [ a owl:Restriction ;
                                            owl:onProperty sulo:isPrecededBy ;
                                            owl:someValuesFrom :ProofingThePizzaDough_StartPhase ] ) ] ] ) ],
        [ a owl:Restriction ;
            owl:onProperty sulo:precedes ;
            owl:someValuesFrom :AssemblingThePizza ],
        <https://w3id.org/ontostart/pro/DevelopmentalProcess> .

:Prosciutto a owl:Class ;
    rdfs:label "prosciutto"@en ;
    rdfs:comment "Prosciutto is an Italian dry-cured ham that is usually thinly sliced and served uncooked; this style is called prosciutto crudo in Italian and is distinguished from cooked ham, prosciutto cotto."^^xsd:string ;
    rdfs:subClassOf :FoodMaterial .

:SlicingThePizza a owl:Class ;
    rdfs:label "slicing the pizza"@en ;
    rdfs:comment "\"Cutting into the pie.\""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:precedes ;
            owl:someValuesFrom :DeliveringThePizza ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/EmergingRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :PizzaSlice ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/ConsumedRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :Pizza ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:precedes ;
            owl:someValuesFrom :PizzaSliceFreezing ],
        <https://w3id.org/ontostart/pro/TransformationProcess> .

:SodiumMeasurement a owl:Class ;
    rdfs:label "sodium measurement"@en ;
    rdfs:comment """As the pizza dough rises in the warm oven, the sodium levels in the ingredients begin to take center stage. Sodium, a essential mineral, plays a crucial role in the process of making the perfect pizza.

As the dough is tossed and stretched, the sodium content of the flour and water comes into play. The sodium ions help to strengthen the gluten network, giving the crust its characteristic chewiness and texture. The sodium also helps to break down the starches in the flour, creating a crispy crust that's both golden brown and crunchy.

As the pizza sauce is spread evenly over the dough, the sodium content of the tomatoes and herbs kicks in. The sodium helps to balance out the acidity of the tomatoes, creating a rich and tangy flavor that complements the cheese and other toppings.

But the sodium doesn't stop there. As the cheese is melted and bubbly, the sodium content of the milk and butter comes into play. The sodium helps to create a creamy and rich sauce that binds the cheese together, creating a velvety texture that's both indulgent and satisfying.

Finally, as the pizza is removed from the oven and allowed to cool, the sodium levels in the crust and cheese continue to play a crucial role. The sodium helps to preserve the crust's crispiness, while also balancing out the flavors of the cheese and other toppings.

In the end, the sodium measurement is a key factor in the process of making the perfect pizza. It's a delicate balance of minerals and flavors that come together to create a culinary masterpiece that's both delicious and satisfying."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:refersTo ;
            owl:someValuesFrom :Saltiness ],
        sulo:Quantity .

:SpicySalami a owl:Class ;
    rdfs:label "spicy salami"@en ;
    rdfs:comment "A salami with a hot or medium spiciness quality."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :SpicyHot :SpicyMedium ) ] ],
        :FoodMaterial .

:Table a owl:Class ;
    rdfs:label "table"@en ;
    rdfs:comment "\"Surface where pizza is served\"."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom <https://w3id.org/ontostart/pro/SurfacePositionRole> ],
        sulo:SpatialObject .

:delivery_box_001 a owl:NamedIndividual,
        :PizzaDeliveryBox ;
    sulo:contains :pizza_001 .

:BakingThePizza a owl:Class ;
    rdfs:label "baking the pizza"@en ;
    rdfs:comment "\"Art of crafting a perfectly cooked pie.\""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom :CheeseMelting ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasPart ;
            owl:someValuesFrom :DoughBaking ],
        [ a owl:Restriction ;
            owl:onProperty sulo:atTime ;
            owl:someValuesFrom :BakingStartTime ],
        [ a owl:Restriction ;
            owl:onProperty sulo:precedes ;
            owl:someValuesFrom :SlicingThePizza ],
        [ a owl:Restriction ;
            owl:onProperty sulo:atTime ;
            owl:someValuesFrom :BakingEndTime ],
        <https://w3id.org/ontostart/pro/DevelopmentalProcess> .

:DeliveringThePizza a owl:Class ;
    rdfs:label "delivering the pizza"@en ;
    rdfs:comment "\"Bringing home the pie.\""@en ;
    rdfs:subClassOf sulo:Process .

:Gorgonzola a owl:Class ;
    rdfs:label "gorgonzola"@en ;
    rdfs:comment "Gorgonzola is a veined Italian blue cheese, made from unskimmed cow's milk."^^xsd:string ;
    rdfs:subClassOf :Cheese .

:Parmesan a owl:Class ;
    rdfs:label "parmesan"@en ;
    rdfs:comment "Parmesan is a hard, granular cheese named after the producing areas near Parma, Italy."^^xsd:string ;
    rdfs:subClassOf :Cheese .

:PecorinoRomano a owl:Class ;
    rdfs:label "pecorino romano"@en ;
    rdfs:comment "Pecorino Romano is a hard, salty Italian cheese, often used for grating, made out of sheep's milk."^^xsd:string ;
    rdfs:subClassOf :Cheese .

:Saltiness a owl:Class ;
    rdfs:label "saltiness"@en ;
    rdfs:comment "Saltiness is a quality that represents the perceived taste of salt in a food material."^^xsd:string ;
    rdfs:subClassOf sulo:Quality .

:Spiciness a owl:Class ;
    rdfs:label "spiciness"@en ;
    rdfs:comment "Spiciness is a quality that represents the perceived heat or pungency of a food material."^^xsd:string ;
    rdfs:subClassOf sulo:Quality .

:SpicinessMeasurement a owl:Class ;
    rdfs:label "spiciness measurement"@en ;
    rdfs:comment """I must preface that the concept of measuring spiciness is more commonly associated with food, such as chili peppers or spicy sauces, rather than a pizza. However, I can attempt to create a descriptive passage related to the process of making a pizza, incorporating the idea of spiciness measurement:

As the pizza dough is tossed and spun into a circular shape, the aroma of freshly baked crust wafts through the air, teasing the senses. The sauce, a rich and tangy blend of crushed tomatoes and herbs, is carefully spread evenly across the surface, providing a tangy foundation for the toppings to come.

Next, the cheese, a blend of melted mozzarella and parmesan, is sprinkled liberally, adding a creamy texture and a burst of salty flavor. The toppings, a colorful medley of vegetables, meats, and spices, are added in a symphony of flavors and textures.

As the pizza is slid into the oven, the heat transforms the ingredients, infusing the crust with a crispy crunch and the cheese with a golden-brown sheen. The aroma of melted mozzarella and baking bread fills the air, enticing the senses.

But what of the spiciness? Ah, that's a different story altogether. The pizza maker has carefully considered the level of heat to add, a balance between savory and spicy that will leave the palate singing. A pinch of red pepper flakes adds a subtle kick, while a sprinkle of hot sauce provides an extra burst of flavor.

And so, the pizza emerges from the oven, a culinary masterpiece that is both comforting and exhilarating. The crust is crispy, the cheese is melted, and the toppings are perfectly balanced. The spiciness, carefully calibrated to add depth and excitement, adds a final flourish to this gastronomic delight.

In this case, the measurement of spiciness is not about assigning a numerical value, but rather about striking a balance between flavors and textures that will leave the palate dancing with joy."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:refersTo ;
            owl:someValuesFrom :Spiciness ],
        sulo:Quantity .

:SpicyHot a owl:Class ;
    rdfs:label "spicy hot"@en ;
    rdfs:comment "A high level of spiciness causing intense heat sensation."^^xsd:string ;
    rdfs:subClassOf :Spiciness .

:SpicyMedium a owl:Class ;
    rdfs:label "spicy medium"@en ;
    rdfs:comment "A moderate level of spiciness."^^xsd:string ;
    rdfs:subClassOf :Spiciness .

:pizza_001 a owl:NamedIndividual,
        :TraditionalFourCheesePizza ;
    sulo:hasDirectPart :crust_of_my_pizza .

:PizzaDeliveryBox a owl:Class ;
    rdfs:label "pizza delivery box"@en ;
    rdfs:comment "\"Carrying the pie to your door.\""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom <https://w3id.org/ontostart/pro/ContainmentRole> ],
        sulo:SpatialObject .

:Mozzarella a owl:Class ;
    rdfs:label "mozzarella"@en ;
    rdfs:comment "Mozzarella is a traditionally southern Italian cheese made from Italian buffalo's milk by the pasta filata method."^^xsd:string ;
    rdfs:subClassOf :Cheese .

:Cheese a owl:Class ;
    rdfs:label "cheese"@en ;
    rdfs:comment "A cheese is a food material derived from milk and produced in a wide range of flavors, textures, and forms by coagulation of the milk protein casein."^^xsd:string ;
    rdfs:subClassOf :FoodMaterial .

:PizzaSauce a owl:Class ;
    rdfs:label "pizza sauce"@en ;
    rdfs:comment "A pizza sauce is a food material used in the preparation of pizza, typically made from tomatoes and various herbs and spices"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasDirectPart ;
            owl:someValuesFrom :OliveOil ],
        :FoodMaterial .

:PizzaDough a owl:Class ;
    rdfs:label "pizza dough"@en ;
    rdfs:comment "Tangy, yeast-leavened foundation."@en ;
    rdfs:subClassOf :FoodMaterial .

:FoodMaterial a owl:Class ;
    rdfs:label "food material"^^xsd:string,
        "food material"@en ;
    rdfs:comment "A food material is a spatial object that is intended for consumption as food."^^xsd:string ;
    rdfs:subClassOf sulo:SpatialObject .

:Pizza a owl:Class ;
    rdfs:label "pizza"@en ;
    rdfs:comment """A pizza is a food material minimally consisting of a pizza crust (baked dough) and optionally topped with 
                    tomatoes or tomato sauce, cheese, and often various other ingredients (such as anchovies, mushrooms, onions, olives, 
                    vegetables, meat, etc.) baked at a high temperature."""^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasDirectPart ;
            owl:someValuesFrom :PizzaSauce ],
        [ a owl:Restriction ;
            owl:onClass :PizzaCrust ;
            owl:onProperty sulo:hasDirectPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :FoodMaterial .

[] a owl:AllDisjointClasses ;
    owl:members ( :PizzaOven :PizzaDeliveryBox :Table ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Mozzarella :Gorgonzola :Parmesan :PecorinoRomano ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Mozzarella :Gorgonzola :Parmesan :PecorinoRomano :Prosciutto ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( :pizza_001 :delivery_box_001 :crust_of_my_pizza :fridge_001 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :LowSalt :MediumSalt :HighSalt ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :SpicyHot :SpicyMedium :SpicyMild ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :SpicyHot :SpicyMedium :SpicyMild ) .

