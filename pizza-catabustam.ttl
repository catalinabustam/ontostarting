@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:description a owl:AnnotationProperty .

: a owl:Ontology ;
    rdfs:label "SULO Pizza Tutorial Ontology"^^xsd:string ;
    dc:creator "https://orcid.org/0000-0002-8048-6295"^^xsd:string ;
    dcterms:alternative "pizza-catabustam"^^xsd:string ;
    dcterms:bibliographicCitation "Unpublished"^^xsd:string ;
    dcterms:contributor "https://orcid.org/0000-0002-8048-6295"^^xsd:string ;
    dcterms:created "2026-09-28T14:47:22.274966+00:00"^^xsd:string ;
    dcterms:description "An OWL ontology for the pizza domain, built incrementally through the SULO Pizza Tutorial. Covers spatial composition, qualities, quantities, processes, information entities, time, and spatial containment."^^xsd:string ;
    dcterms:issued "2026-09-28"^^xsd:string ;
    dcterms:language "http://lexvo.org/id/iso639-1/en"^^xsd:string ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:string ;
    dcterms:modified "2026-09-28T14:47:22.274966+00:00"^^xsd:string ;
    dcterms:publisher "https://github.com/catalinabustam"^^xsd:string ;
    dcterms:title "SULO Pizza Tutorial Ontology"^^xsd:string ;
    pav:authoredBy "https://orcid.org/0000-0002-8048-6295"^^xsd:string ;
    vann:preferredNamespacePrefix "pizza-catabustam"^^xsd:string ;
    vann:preferredNamespaceUri "https://w3id.org/ontostart/pizza-catabustam/"^^xsd:string ;
    rdfs:comment "An OWL ontology for the pizza domain, built incrementally through the SULO Pizza Tutorial. Covers spatial composition, qualities, quantities, processes, information entities, time, and spatial containment."^^xsd:string ;
    owl:imports <https://w3id.org/ontostart/pro>,
        <https://w3id.org/sulo> ;
    owl:versionIRI <https://w3id.org/ontostart/pizza/releases/1.0.0/pizza.owl> ;
    owl:versionInfo "1.0.0"^^xsd:string ;
    dcat:accessURL "https://w3id.org/ontostart/pizza-catabustam/"^^xsd:string ;
    foaf:homepage "https://github.com/catalinabustam/ontostart"^^xsd:string ;
    mod:definitionProperty "http://www.w3.org/2000/01/rdf-schema#comment"^^xsd:string ;
    mod:hasRepresentationLanguage "http://omv.ontoware.org/2005/05/ontology#OWL"^^xsd:string ;
    mod:hasSyntax "http://www.w3.org/ns/formats/Turtle"^^xsd:string ;
    mod:prefLabelProperty "http://www.w3.org/2000/01/rdf-schema#label"^^xsd:string ;
    mod:status "active"^^xsd:string .

:AnchovyPizza a owl:Class ;
    rdfs:label "anchovy pizza"@en ;
    rdfs:comment """The word "AnchovyPizza" evokes a sensory experience of a savory and salty delight. It conjures up images of a perfectly cooked crust, golden brown and crispy on the edges, giving way to a rich and creamy sauce that's been infused with the pungency of fresh basil.

The star of the show, however, is the anchovy - a salty, fishy delight that adds a depth of flavor and a hint of umami to the pizza. Thinly sliced and perfectly balanced, the anchovies dance across the surface of the pizza, leaving a trail of brininess in their wake.

As the pizza is lifted to the lips, the aroma of melted mozzarella and the slight sweetness of the tomato sauce mingle with the savory scent of the anchovies, creating a mouthwatering bouquet that's impossible to resist. The first bite is a revelation - the crunch of the crust giving way to a tidal wave of flavors that washes over the palate, leaving a lasting impression of salty, savory goodness."""@en ;
    rdfs:subClassOf :Pizza ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onClass :AnchovyIngredient ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( :AnchovyIngredient :PizzaSauce ) ] ;
                        owl:onProperty sulo:hasDirectPart ] ) ] .

:BakingDuration a owl:Class ;
    rdfs:label "baking duration"@en ;
    rdfs:comment "\"Time spent in the oven\"."@en ;
    rdfs:subClassOf sulo:Duration ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( sulo:Duration [ a owl:Restriction ;
                        owl:onProperty sulo:hasValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:maxInclusive 15.0 ] [ xsd:minInclusive 8.0 ] ) ] ] ) ] .

:BoxedPizza a owl:Class ;
    rdfs:label "boxed pizza"@en ;
    rdfs:comment "A culinary creation, often served in a rectangular, paper or cardboard container."@en ;
    rdfs:subClassOf :Pizza ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onProperty sulo:isIn ;
                        owl:someValuesFrom :PizzaDeliveryBox ] ) ] .

:ExpressPizzaDelivery a owl:Class ;
    rdfs:label "express pizza delivery"@en ;
    rdfs:comment "\"Convenient culinary convenience\"."@en ;
    rdfs:subClassOf :DeliveringThePizza ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :DeliveringThePizza [ a owl:Restriction ;
                        owl:onProperty sulo:atTime ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :DeliveryDuration [ a owl:Restriction ;
                                            owl:onProperty sulo:hasValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:decimal ;
                                                    owl:withRestrictions ( [ xsd:maxInclusive 30.0 ] ) ] ] ) ] ] ) ] .

:FourCheesePizza a owl:Class ;
    rdfs:label "four cheese pizza"@en ;
    rdfs:comment "A Four Cheese Pizza is a pizza that contains exactly four different types of cheese as toppings."^^xsd:string ;
    rdfs:subClassOf :Pizza ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onClass :Cheese ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "4"^^xsd:nonNegativeInteger ] ) ] .

:HotPepperPizza a owl:Class ;
    rdfs:label "hot pepper pizza"@en ;
    rdfs:comment """The concept of HotPepperPizza is intricately tied to the process of crafting a delicious pie. It begins with the preparation of the dough, where yeast is activated to leaven the crust, giving it a light and airy texture. As the dough rises, it is then shaped into a perfect circle, awaiting the arrival of its signature topping - the HotPepper.

This spicy addition is carefully sprinkled across the surface of the dough, adding a bold and adventurous flavor profile to the pizza. The aroma of toasted garlic and oregano wafts through the air, enticing the senses and building anticipation for the final product.

Next, the sauce is spread evenly across the dough, providing a tangy and slightly sweet contrast to the spicy kick of the HotPepper. A blend of melted mozzarella and parmesan cheese is then added, binding the flavors together and creating a rich, velvety texture.

As the pizza enters the oven, the crust browns to a golden perfection, while the sauce and cheese bubble and simmer, releasing a savory aroma that teases the taste buds. The final result is a HotPepperPizza that is both a feast for the eyes and a symphony of flavors on the palate."""@en ;
    rdfs:subClassOf :Pizza ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onClass :PizzaSauce ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass :HotPepper ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:allValuesFrom :HotPepper ;
                        owl:onProperty sulo:hasDirectPart ] ) ] .

:KneadingTheDough a owl:Class ;
    rdfs:label "kneading the dough"@en ;
    rdfs:comment "\"Shaping the foundation of a perfectly cooked crust.\""@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <https://w3id.org/ontostart/pro/DevelopmentRole> [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :PizzaDough ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty sulo:hasParticipant ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <https://w3id.org/ontostart/pro/InstrumentRole> [ a owl:Restriction ;
                                            owl:onProperty sulo:isFeatureOf ;
                                            owl:someValuesFrom :Mixer ] ) ] ] ) ],
        <https://w3id.org/ontostart/pro/DevelopmentalProcess> .

:PizzaRecipe a owl:Class ;
    rdfs:label "pizza recipe"@en ;
    rdfs:comment "The word \"PizzaRecipe\" is a master plan."@en ;
    rdfs:subClassOf sulo:InformationObject ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( sulo:InformationObject [ a owl:Restriction ;
                        owl:onProperty sulo:refersTo ;
                        owl:someValuesFrom :PizzaMakingProcess ] ) ] .

:ProsciuttoMozzarellaPizza a owl:Class ;
    rdfs:label "prosciutto mozzarella pizza"@en ;
    rdfs:comment "A Prosciutto Mozzarella Pizza is a pizza made with prosciutto and mozzarella cheese."^^xsd:string ;
    rdfs:subClassOf :Pizza ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onClass :Prosciutto ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass :Mozzarella ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( :Prosciutto :Mozzarella ) ] ;
                        owl:onProperty sulo:hasDirectPart ] ) ] .

:SaltyPizza a owl:Class ;
    rdfs:label "salty pizza"@en ;
    rdfs:comment """SaltyPizza: A savory union of flavors and textures that embodies the essence of a perfectly baked pizza.

As the dough emerges from the fiery oven, its golden crust glistens with a subtle sheen, inviting the senses to explore its crispy edges and soft center. The aroma of freshly baked crust wafts up, carrying the promise of a delicious creation.

Next, the savory sauce is carefully spread, a rich and tangy foundation for the flavors to come. The sweetness of the tomato sauce is expertly balanced by the savory undertones of the cheese, a creamy and velvety delight that binds the dish together.

The cheese, a blend of mozzarella, parmesan, and other artisanal favorites, is melted to perfection, its strings of melted goodness stretching and pulling as it's devoured. As the cheese hits the hot pan, it releases its signature aroma, a heady mix of umami and richness that teases the taste buds.

The toppings, a colorful medley of meats, vegetables, and herbs, add a pop of freshness and flavor to the dish. The crunch of crispy bacon, the sweetness of caramelized onions, and the pungency of fresh basil all combine to create a symphony of tastes that will leave you wanting more.

Finally, the finishing touches are applied: a drizzle of extra virgin olive oil, a sprinkle of sea salt, and a few grinds of freshly grated parmesan. The result is a culinary masterpiece, a SaltyPizza that is at once familiar and exciting, comforting and indulgent.

This SaltyPizza is more than just a meal - it's an experience, a sensory delight that will leave you feeling satisfied, content, and eager for the next delicious bite."""@en ;
    rdfs:subClassOf :Pizza ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onProperty sulo:hasPart ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty sulo:hasFeature ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( :SodiumMeasurement [ a owl:Restriction ;
                                                    owl:onProperty sulo:hasValue ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:integer ;
                                                            owl:withRestrictions ( [ xsd:minInclusive 1400 ] ) ] ] ) ] ] ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty sulo:hasFeature ;
                                owl:someValuesFrom :HighSalt ] ] ) ] .

:SpicyPizzaOrder a owl:Class ;
    rdfs:label "order for spicy pizza"@en ;
    rdfs:comment "A culinary term that perfectly encapsulates the bold flavors and sensations of a piping hot, aromatic pizza that ignites the senses."@en ;
    rdfs:subClassOf :Order ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Order [ a owl:Restriction ;
                        owl:onProperty sulo:refersTo ;
                        owl:someValuesFrom :SpicyPizza ] ) ] .

:example a owl:NamedIndividual,
        :DesaltedAnchovyPizza .

:order_001 a owl:NamedIndividual,
        :Order ;
    rdfs:label "Pizza Order #001"^^xsd:string ;
    rdfs:comment "Order for a Traditional Four Cheese Pizza and a Spicy Salami Pizza."^^xsd:string ;
    sulo:hasPart :id_001,
        :order_items_001 ;
    sulo:refersTo :spicy_salami_pizza_001 .

:ordering_event_001 a owl:NamedIndividual,
        :OrderingProcess ;
    sulo:atTime :t_order_received_001 ;
    sulo:precedes :making_event_001 .

:pizza_boxing_001 a owl:NamedIndividual,
        :BoxingThePizza ;
    sulo:hasParticipant :box_containment_role_001,
        :pizza_contained_role_001 ;
    sulo:precedes :pizza_unboxing_001 .

:recipe_001 a owl:NamedIndividual,
        sulo:InformationObject ;
    rdfs:label "Traditional Neapolitan Pizza Recipe"^^xsd:string ;
    sulo:refersTo :making_001 .

:BakersYeast a owl:Class ;
    rdfs:label "baker's yeast"@en ;
    rdfs:comment "Essential ingredient."@en ;
    rdfs:subClassOf :FoodMaterial .

:BoxingThePizza a owl:Class ;
    rdfs:label "boxing the pizza"@en ;
    rdfs:comment "A playful name for a delicious treat."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/ContainedRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :Pizza ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/ContainmentRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :PizzaDeliveryBox ] ) ] ],
        sulo:Process .

:CheeseMelting a owl:Class ;
    rdfs:label "cheese melting"@en ;
    rdfs:comment "\"Velvety surrender\""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/DevelopmentRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :Cheese ] ) ] ],
        <https://w3id.org/ontostart/pro/DevelopmentalProcess> .

:Cornicione a owl:Class ;
    rdfs:label "cornicione"@en ;
    rdfs:comment "A cornicione is the outer edge of a pizza crust"^^xsd:string ;
    rdfs:subClassOf :FoodMaterial .

:DeliveryTime a owl:Class ;
    rdfs:label "delivery time"@en ;
    rdfs:comment "\"Wait Period\"."@en ;
    rdfs:subClassOf sulo:TimeInstant .

:DenseTexture a owl:Class ;
    rdfs:label "dense texture"@en ;
    rdfs:comment "\"Thick and chewy crust\"."@en ;
    rdfs:subClassOf :DoughTexture ;
    owl:disjointWith :AiryTexture .

:DesaltedAnchovyPizza a owl:Class ;
    rdfs:label "desalted anchovy pizza"@en ;
    rdfs:comment """Here's a short descriptive of the word "DesaltedAnchovyPizza" related to the process of a pizza:

"DesaltedAnchovyPizza" is the term used to describe the final stage of pizza preparation where the anchovies have been carefully removed from the dough, allowing for a cleaner and more refined flavor profile. This step is crucial in creating a balanced taste experience, as the salty, fishy flavor of the anchovies is balanced by the sweetness of the tomato sauce and the tanginess of the melted mozzarella cheese. The desalted anchovy pizza is now ready to be baked to perfection, bringing all the flavors together in a harmonious union of savory delight."""@en ;
    rdfs:subClassOf :Pizza ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onClass :DesaltedAnchovyIngredient ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( :DesaltedAnchovyIngredient :PizzaSauce ) ] ;
                        owl:onProperty sulo:hasDirectPart ] ) ] .

:DoughBaking a owl:Class ;
    rdfs:label "dough baking"@en ;
    rdfs:comment "\"Artisanal blending of flour, water, and time.\""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/DevelopmentRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( :PizzaDough :PizzaCrust ) ] ] ) ] ],
        <https://w3id.org/ontostart/pro/DevelopmentalProcess> .

:Flour a owl:Class ;
    rdfs:label "flour"@en ;
    rdfs:comment """The word "flour" takes on a vital role in the pizza-making process, serving as the foundation upon which the dough is crafted. It is the primary ingredient that, when combined with water, yeast, and other additives, gives the crust its structure and texture.

As the mixture of flour and water is kneaded, the gluten strands begin to form, providing the dough with elasticity and resilience. The dough is then allowed to rise, giving the flour a chance to fully absorb the liquid ingredients and develop its complex flavor profile.

As the dough is shaped and topped with ingredients, the flour becomes the base upon which the entire pizza is built. Its subtle sweetness and nutty undertones add depth and nuance to the finished product, complementing the savory flavors of the sauce, cheese, and various toppings.

Throughout the cooking process, the flour undergoes a transformation, becoming crispy and golden on the outside, while remaining soft and slightly chewy on the inside. It is this delicate balance of texture and flavor that makes flour an essential component of the pizza-making process."""@en ;
    rdfs:subClassOf :FoodMaterial .

:LowSalt a owl:Class ;
    rdfs:label "low salt"@en ;
    rdfs:comment "A low level of saltiness."^^xsd:string ;
    rdfs:subClassOf :Saltiness .

:MediumSalt a owl:Class ;
    rdfs:label "medium salt"@en ;
    rdfs:comment "A moderate level of saltiness."^^xsd:string ;
    rdfs:subClassOf :Saltiness .

:Mixer a owl:Class ;
    rdfs:label "mixer"@en ;
    rdfs:comment "\"Central component\""@en ;
    rdfs:subClassOf sulo:SpatialObject .

:OliveOil a owl:Class ;
    rdfs:label "olive oil"@en ;
    rdfs:comment "A type of cooking oil made from olives"@en ;
    rdfs:subClassOf :FoodMaterial .

:OrderIdentifier a owl:Class ;
    rdfs:label "order identifier"@en ;
    rdfs:comment "\"Labeling component\""@en ;
    rdfs:subClassOf sulo:InformationObject .

:OrderReceivedTime a owl:Class ;
    rdfs:label "order received time"@en ;
    rdfs:comment "\"Confirmation of the pie's arrival\"."@en ;
    rdfs:subClassOf sulo:TimeInstant .

:OrderingProcess a owl:Class ;
    rdfs:label "ordering process"@en ;
    rdfs:comment "\"Step-by-Step Culinary Journey\""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:precedes ;
            owl:someValuesFrom :MakingThePizzaDough ],
        sulo:Process .

:PizzaOven a owl:Class ;
    rdfs:label "pizza oven"@en ;
    rdfs:comment "\"Signature cooking vessel\""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasFeature ;
            owl:someValuesFrom <https://w3id.org/ontostart/pro/ContainmentRole> ],
        sulo:SpatialObject .

:PizzaSliceFreezing a owl:Class ;
    rdfs:label "pizza slice freezing"@en ;
    rdfs:comment "\"Crystallizing the essence of a pizza.\""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/DevelopmentRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :PizzaSlice ] ) ] ],
        <https://w3id.org/ontostart/pro/DevelopmentalProcess> .

:PlacingPizzaOnTable a owl:Class ;
    rdfs:label "placing pizza on table"@en ;
    rdfs:comment "The word \"PlacingPizzaOnTable\" is an Action."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/SurfacePositionRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :Table ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/OnTopPositionRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :Pizza ] ) ] ],
        sulo:Process .

:Salt a owl:Class ;
    rdfs:label "salt"@en ;
    rdfs:comment "\"Flavor Enhancer\""@en ;
    rdfs:subClassOf :FoodMaterial .

:SpicySalamiPizza a owl:Class ;
    rdfs:label "spicy salami pizza"@en ;
    rdfs:comment """The word "SpicySalamiPizza" evokes a sensory experience that combines the aroma, taste, and visual appeal of a freshly baked pizza. Here's a descriptive breakdown of the process involved in creating this mouthwatering dish:

**Aroma**: As the pizza dough is being mixed and kneaded, a subtle scent of yeast and flour wafts through the air, hinting at the complexity of flavors to come. As the sauce is spread evenly, a tangy aroma of crushed tomatoes and herbs fills the air, tantalizing the senses.

**Topping Preparation**: The spicy salami is sliced and arranged artfully on the pizza, its crispy edges and vibrant red color adding a pop of visual interest. The pungent aroma of salami wafts up, mingling with the savory scent of melted mozzarella cheese.

**Assembly and Baking**: As the pizza is placed in the oven, the heat triggers a transformation, and the aroma of baking crust and melting cheese fills the air. The spicy salami and melted mozzarella mingle, releasing a savory, spicy fragrance that teases the taste buds.

**Finishing Touches**: As the pizza emerges from the oven, golden and bubbly, the aroma of freshly baked crust and melted cheese fills the air. The spicy salami and fresh basil add a bright, herbaceous note, balancing the richness of the cheese and sauce.

**Tasting**: The first bite is like a symphony of flavors and textures, with the spicy salami, tangy sauce, and creamy cheese harmonizing on the palate. The crispy crust provides a satisfying crunch, while the fresh basil adds a bright, refreshing note that leaves the senses singing.

The word "SpicySalamiPizza" embodies the entire pizza-making process, from the initial aroma of dough and sauce to the final taste of a perfectly balanced, mouthwatering masterpiece."""@en ;
    rdfs:subClassOf :Pizza ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Pizza [ a owl:Restriction ;
                        owl:onClass :PizzaSauce ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass :SpicySalami ;
                        owl:onProperty sulo:hasDirectPart ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( :SpicySalami :PizzaSauce ) ] ;
                        owl:onProperty sulo:hasDirectPart ] ) ] .

:Sugar a owl:Class ;
    rdfs:label "sugar"@en ;
    rdfs:comment """Here's a short descriptive of the word "Sugar" related to the process of making a pizza:

In the context of pizza making, sugar refers to a key ingredient in the sauce that adds a sweet and tangy flavor to the pizza crust. As the dough rises, a small amount of sugar is added to the yeast, which helps to feed the yeast's growth and fermentation process. This results in a more complex flavor profile and a crisper crust. However, it's worth noting that traditional Neapolitan pizza recipes do not typically include sugar in the sauce."""@en ;
    rdfs:subClassOf :FoodMaterial .

:UnboxingThePizza a owl:Class ;
    rdfs:label "unboxing the pizza"@en ;
    rdfs:comment "Joyful unraveling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/ContainedRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :Pizza ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty sulo:hasParticipant ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/ontostart/pro/ContainmentRole> [ a owl:Restriction ;
                                owl:onProperty sulo:isFeatureOf ;
                                owl:someValuesFrom :PizzaDeliveryBox ] ) ] ],
        sulo:Process .

:UnproofedDoughRole a owl:Class ;
    rdfs:label "unproofed dough role"@en ;
    rdfs:comment "The role of the pizza dough being unproofed"@en ;
    rdfs:subClassOf sulo:Role ;
    owl:disjointWith :ProofedDoughRole .

:Water a owl:Class ;
    rdfs:label "water"@en ;
    rdfs:comment """What a unique combination! Here's a short description of the word "Water" related to the process of making a pizza:

Water, in the context of pizza making, represents the liquid love that brings the dough to life. As the water is poured into the mixing bowl, it awakens the yeast, allowing the fermentation process to begin. The water then becomes the foundation of the dough, providing structure and moisture as it rises in the oven. Even after the pizza has emerged, the water plays a role in the crust's crispiness, as the steam it releases helps create the perfect golden-brown texture. In this sense, water is the unsung hero of the pizza-making process, bringing the perfect balance of moisture and texture to the finished product."""@en ;
    rdfs:subClassOf :FoodMaterial .

:baking_event_001 a owl:NamedIndividual,
        :BakingThePizza ;
    sulo:atTime :t_bake_end_001,
        :t_bake_start_001 ;
    sulo:precedes :delivering_event_001 .

:delivering_event_001 a owl:NamedIndividual,
